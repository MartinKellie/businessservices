# Copy to .env and fill in local values. Never commit .env.

# --- Database (Neon Postgres with PostGIS) ---
# Local development / tests use docker-compose (see README):
DATABASE_URL=postgresql://directory:directory@localhost:5432/directory
# Force the driver if autodetection is wrong: node | neon
# DB_DRIVER=node

# --- Auth.js / Google OAuth (admin sign-in) ---
# Generate: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only needed when the deployment URL cannot be inferred:
# AUTH_URL=http://localhost:3000

# --- Vercel Blob (business media + enquiry uploads) ---
BLOB_READ_WRITE_TOKEN=

# --- Admin enquiry notifications (Resend) ---
RESEND_API_KEY=
ENQUIRY_NOTIFICATION_TO=
ENQUIRY_NOTIFICATION_FROM=Directorio <noreply@example.com>

# --- Map (MapLibre; provider-agnostic vector-tile style URL) ---
# Optional. When empty, the public map uses an OSM raster fallback.
NEXT_PUBLIC_MAP_STYLE_URL=

# --- Scheduled jobs (Vercel Cron) ---
CRON_SECRET=

# --- Geocoding ("Near me" address/area lookup, via Nominatim) ---
# Required by the Nominatim usage policy to identify the application; falls back to a
# generic value if unset. https://operations.osmfoundation.org/policies/nominatim/
GEOCODE_CONTACT_EMAIL=

# Set for CI build/lint/typecheck steps that do not need real secrets:
# SKIP_ENV_VALIDATION=1
